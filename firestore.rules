rules_version = '2';
// Reglas de la base de datos de RBM Solutions (rbmsolutionscr.com)
// Pegar completas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // El administrador es el usuario creado en Firebase → Authentication con este correo.
    function esAdmin() {
      return request.auth != null && request.auth.token.email == 'rbmsolutions819@gmail.com';
    }
    // Tarjetas de sellos (demos): valor en sellos (sellos + 10 × gratis) y total de toda la vida.
    function kkVal(d) { return d.get('sellos', 0) + 10 * d.get('gratis', 0); }
    function kkTotal(d) { return d.get('total', d.get('sellos', 0) + 10 * (d.get('gratis', 0) + d.get('canjes', 0))); }
    function correoOk(c) { return c is string && c.size() <= 100 && (c == '' || c.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')); }
    // Promociones de los demos: título, texto, producto (opcional) y días en que se repite (0 = domingo).
    function promoOk(d) {
      return d.keys().hasOnly(['titulo','texto','producto','dias','creado'])
        && d.titulo is string && d.titulo.size() >= 2 && d.titulo.size() <= 60
        && d.texto is string && d.texto.size() <= 200
        && d.producto is string && d.producto.size() <= 60
        && d.dias is list && d.dias.size() <= 7;
    }
    function fechaOk(f) { return f is string && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // Citas: cualquiera puede agendar; solo el administrador las ve, las cancela y les agrega apuntes.
    match /citas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['fecha','ini','dur','servicio','lugar','nombre','tel','dir','nota','creada'])
        && fechaOk(request.resource.data.fecha)
        && request.resource.data.ini is int && request.resource.data.ini >= 0 && request.resource.data.ini < 1440
        && request.resource.data.dur in [30, 60, 90, 120, 180]
        && request.resource.data.lugar in ['taller', 'domicilio', 'remoto']
        && request.resource.data.servicio is string && request.resource.data.servicio.size() <= 80
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 50
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
        && request.resource.data.dir is string && request.resource.data.dir.size() <= 200
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 400
        && request.resource.data.creada == request.time;
      allow read, delete: if esAdmin();
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apuntes'])
        && request.resource.data.apuntes is string && request.resource.data.apuntes.size() <= 1000;
    }

    // Espacios ocupados: todos los ven (sin datos personales). Un espacio tomado no se puede volver a tomar.
    match /ocupados/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['fecha','cita'])
        && fechaOk(request.resource.data.fecha)
        && id.matches('^' + request.resource.data.fecha + '_[0-9]{4}$')
        && request.resource.data.cita is string
        && existsAfter(/databases/$(database)/documents/citas/$(request.resource.data.cita));
      allow delete: if esAdmin();
    }

    // Sugerencias: cualquiera envía; solo el administrador las lee y las borra.
    match /sugerencias/{id} {
      allow create: if request.resource.data.keys().hasOnly(['texto','nombre','fecha'])
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 600
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
        && request.resource.data.fecha == request.time;
      allow read, delete: if esAdmin();
    }

    // Galería: todos la ven; solo el administrador sube fotos o links de video.
    match /galeria/{id} {
      allow read: if true;
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['tipo','data','url','titulo','orden'])
        && request.resource.data.tipo in ['foto', 'video']
        && request.resource.data.data is string && request.resource.data.data.size() < 950000
        && request.resource.data.url is string && request.resource.data.url.size() <= 300
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 60
        && request.resource.data.orden is number;
      allow delete: if esAdmin();
    }

    // Encuestas de satisfacción: una por cita (el id es el de la cita); solo el administrador las lee.
    match /encuestas/{id} {
      allow create: if exists(/databases/$(database)/documents/citas/$(id))
        && request.resource.data.keys().hasOnly(['estrellas','calidad','trato','recomendaria','comentario','nombre','fecha'])
        && request.resource.data.estrellas is int && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5
        && request.resource.data.calidad is int && request.resource.data.calidad >= 1 && request.resource.data.calidad <= 5
        && request.resource.data.trato is int && request.resource.data.trato >= 1 && request.resource.data.trato <= 5
        && request.resource.data.recomendaria in ['si', 'tal vez', 'no']
        && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 600
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
        && request.resource.data.fecha == request.time;
      allow read, delete: if esAdmin();
    }

    // Boletas del taller (equipos recibidos, en proceso y finalizados): solo el administrador.
    match /boletas/{id} {
      allow read, delete: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.num is int
        && request.resource.data.estado in ['proceso', 'final']
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60;
    }

    // Fotos de las boletas (cómo se recibe y trabajo final): solo el administrador.
    match /bolfotos/{id} {
      allow read, delete: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(['bol','etapa','data','orden'])
        && request.resource.data.bol is string
        && request.resource.data.etapa in ['rec', 'fin']
        && request.resource.data.data is string && request.resource.data.data.size() < 950000;
    }

    // Opiniones que el administrador decide mostrar en la página: todos las ven, solo él las publica o quita.
    match /resenas/{id} {
      allow read: if true;
      allow delete: if esAdmin();
      allow create, update: if esAdmin()
        && exists(/databases/$(database)/documents/encuestas/$(id))
        && request.resource.data.keys().hasOnly(['nombre','estrellas','calidad','trato','comentario','servicio','fecha'])
        && request.resource.data.estrellas is int && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
        && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 600
        && request.resource.data.servicio is string && request.resource.data.servicio.size() <= 80;
    }

    // Qué demos se muestran en la página: todos lo leen, solo el administrador lo cambia.
    match /ajustes/demos {
      allow read: if true;
      allow write: if esAdmin()
        && request.resource.data.keys().hasOnly(['publicadas'])
        && request.resource.data.publicadas is list && request.resource.data.publicadas.size() <= 40;
    }

    // Demo Matcha Mía: mismas reglas que Koktela (sellos 0 a 9 + gratis guardados; nunca restar sellos).
    match /demo_matcha_clientes/{t} {
      allow get: if true;
      allow list: if esAdmin();
      allow create: if t.size() >= 16 && t.size() <= 40
        && request.resource.data.keys().hasOnly(['nombre','ced4','correo','sellos','gratis','canjes','total','creado','actualizado'])
        && correoOk(request.resource.data.get('correo', ''))
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 60
        && request.resource.data.ced4 is string && request.resource.data.ced4.size() == 4
        && request.resource.data.sellos == 0 && request.resource.data.canjes == 0
        && request.resource.data.get('gratis', 0) == 0 && request.resource.data.get('total', 0) == 0
        && request.resource.data.creado == request.time && request.resource.data.actualizado == request.time;
      // El cliente puede poner o cambiar su correo (solo eso).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['correo'])
        && correoOk(request.resource.data.correo);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellos','gratis','canjes','total','actualizado'])
        && request.resource.data.actualizado == request.time
        && request.resource.data.sellos is int && request.resource.data.sellos >= 0 && request.resource.data.sellos <= 9
        && request.resource.data.gratis is int && request.resource.data.gratis >= 0
        && request.resource.data.canjes is int && request.resource.data.total is int
        && (
          (request.resource.data.canjes == resource.data.get('canjes', 0)
            && request.resource.data.total > kkTotal(resource.data)
            && request.resource.data.total - kkTotal(resource.data) <= 50
            && kkVal(request.resource.data) == kkVal(resource.data) + (request.resource.data.total - kkTotal(resource.data)))
          || (request.resource.data.total == kkTotal(resource.data)
            && request.resource.data.canjes > resource.data.get('canjes', 0)
            && kkVal(request.resource.data) == kkVal(resource.data) - 10 * (request.resource.data.canjes - resource.data.get('canjes', 0)))
        );
      allow delete: if esAdmin();
    }
    // Índice para buscar por cédula: la llave es una huella (hash) de la cédula, no la cédula.
    match /demo_matcha_ced/{h} {
      allow get: if true;
      allow list, update: if false;
      allow create: if h.size() == 64
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t is string
        && existsAfter(/databases/$(database)/documents/demo_matcha_clientes/$(request.resource.data.t));
      allow delete: if esAdmin();
    }

    // Demo Koktela: tarjetas de sellos. Se abren solo con su código secreto (no se pueden listar).
    // sellos (0 a 9) + 10 × gratis guardados. total = sellos de toda la vida.
    // Solo se puede SUMAR sellos (cada 10 se vuelven un gratis) o canjear gratis que ya tenga. Nunca restar sellos.
    match /demo_koktela_clientes/{t} {
      allow get: if true;
      allow list: if esAdmin();
      allow create: if t.size() >= 16 && t.size() <= 40
        && request.resource.data.keys().hasOnly(['nombre','ced4','correo','sellos','gratis','canjes','total','creado','actualizado'])
        && correoOk(request.resource.data.get('correo', ''))
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 60
        && request.resource.data.ced4 is string && request.resource.data.ced4.size() == 4
        && request.resource.data.sellos == 0 && request.resource.data.canjes == 0
        && request.resource.data.get('gratis', 0) == 0 && request.resource.data.get('total', 0) == 0
        && request.resource.data.creado == request.time && request.resource.data.actualizado == request.time;
      // El cliente puede poner o cambiar su correo (solo eso).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['correo'])
        && correoOk(request.resource.data.correo);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellos','gratis','canjes','total','actualizado'])
        && request.resource.data.actualizado == request.time
        && request.resource.data.sellos is int && request.resource.data.sellos >= 0 && request.resource.data.sellos <= 9
        && request.resource.data.gratis is int && request.resource.data.gratis >= 0
        && request.resource.data.canjes is int && request.resource.data.total is int
        && (
          (request.resource.data.canjes == resource.data.get('canjes', 0)
            && request.resource.data.total > kkTotal(resource.data)
            && request.resource.data.total - kkTotal(resource.data) <= 50
            && kkVal(request.resource.data) == kkVal(resource.data) + (request.resource.data.total - kkTotal(resource.data)))
          || (request.resource.data.total == kkTotal(resource.data)
            && request.resource.data.canjes > resource.data.get('canjes', 0)
            && kkVal(request.resource.data) == kkVal(resource.data) - 10 * (request.resource.data.canjes - resource.data.get('canjes', 0)))
        );
      allow delete: if esAdmin();
    }
    // Índice para buscar por cédula: la llave es una huella (hash) de la cédula, no la cédula.
    match /demo_koktela_ced/{h} {
      allow get: if true;
      allow list, update: if false;
      allow create: if h.size() == 64
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t is string
        && existsAfter(/databases/$(database)/documents/demo_koktela_clientes/$(request.resource.data.t));
      allow delete: if esAdmin();
    }

    // Usuario del cliente de Koktela: la llave es una huella de cédula + clave; apunta a su tarjeta.
    match /demo_koktela_acceso/{h} {
      allow get: if true;
      allow list, update: if false;
      allow create: if h.size() == 64
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t is string
        && exists(/databases/$(database)/documents/demo_koktela_clientes/$(request.resource.data.t));
      allow delete: if esAdmin();
    }

    // MODO PRUEBA de Koktela: base de datos aparte, con datos de ejemplo. Cualquiera la puede reiniciar.
    match /prueba_koktela_clientes/{t} {
      allow read, delete: if true;
      allow create, update: if t.size() >= 16 && t.size() <= 40
        && request.resource.data.keys().hasOnly(['nombre','ced4','correo','sellos','gratis','canjes','total','creado','actualizado'])
        && correoOk(request.resource.data.get('correo', ''))
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60
        && request.resource.data.sellos is int && request.resource.data.sellos >= 0 && request.resource.data.sellos <= 10
        && request.resource.data.get('gratis', 0) is int && request.resource.data.get('gratis', 0) >= 0 && request.resource.data.get('gratis', 0) <= 1000
        && request.resource.data.get('total', 0) is int && request.resource.data.get('total', 0) >= 0
        && request.resource.data.canjes is int && request.resource.data.canjes >= 0 && request.resource.data.canjes <= 1000;
    }
    match /prueba_koktela_ced/{h} {
      allow read, delete: if true;
      allow create, update: if h.size() == 64 && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is string && request.resource.data.t.size() <= 40;
    }
    match /prueba_koktela_acceso/{h} {
      allow read, delete: if true;
      allow create, update: if h.size() == 64 && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is string && request.resource.data.t.size() <= 40;
    }

    // Usuario del cliente de Matcha Mía: la llave es una huella de cédula + clave; apunta a su tarjeta.
    match /demo_matcha_acceso/{h} {
      allow get: if true;
      allow list, update: if false;
      allow create: if h.size() == 64
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t is string
        && exists(/databases/$(database)/documents/demo_matcha_clientes/$(request.resource.data.t));
      allow delete: if esAdmin();
    }

    // MODO PRUEBA de Matcha Mía: base de datos aparte, con datos de ejemplo. Cualquiera la puede reiniciar.
    match /prueba_matcha_clientes/{t} {
      allow read, delete: if true;
      allow create, update: if t.size() >= 16 && t.size() <= 40
        && request.resource.data.keys().hasOnly(['nombre','ced4','correo','sellos','gratis','canjes','total','creado','actualizado'])
        && correoOk(request.resource.data.get('correo', ''))
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60
        && request.resource.data.sellos is int && request.resource.data.sellos >= 0 && request.resource.data.sellos <= 10
        && request.resource.data.get('gratis', 0) is int && request.resource.data.get('gratis', 0) >= 0 && request.resource.data.get('gratis', 0) <= 1000
        && request.resource.data.get('total', 0) is int && request.resource.data.get('total', 0) >= 0
        && request.resource.data.canjes is int && request.resource.data.canjes >= 0 && request.resource.data.canjes <= 1000;
    }
    match /prueba_matcha_ced/{h} {
      allow read, delete: if true;
      allow create, update: if h.size() == 64 && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is string && request.resource.data.t.size() <= 40;
    }
    match /prueba_matcha_acceso/{h} {
      allow read, delete: if true;
      allow create, update: if h.size() == 64 && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is string && request.resource.data.t.size() <= 40;
    }

    // Matcha Mía: sellos de pedidos a domicilio. El id es la app + el número de orden, así una orden se reclama una sola vez.
    // La dueña la busca con el número que ve en su tablet de Uber/DiDi y la aprueba (suma sellos) o la rechaza.
    match /demo_matcha_reclamos/{id} {
      allow get: if true;
      allow list: if esAdmin();
      allow create: if id.size() >= 6 && id.size() <= 40
        && request.resource.data.keys().hasOnly(['t','nombre','app','orden','estado','creado'])
        && request.resource.data.app in ['UBER', 'DIDI', 'RAPPI']
        && id == request.resource.data.app + '-' + request.resource.data.orden
        && request.resource.data.orden is string && request.resource.data.orden.size() >= 3 && request.resource.data.orden.size() <= 30
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60
        && request.resource.data.t is string && exists(/databases/$(database)/documents/demo_matcha_clientes/$(request.resource.data.t))
        && request.resource.data.estado == 'pendiente' && request.resource.data.creado == request.time;
      allow update: if resource.data.estado == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','sellos','revisado'])
        && request.resource.data.estado in ['aprobado', 'rechazado']
        && request.resource.data.sellos is int && request.resource.data.sellos >= 0 && request.resource.data.sellos <= 20
        && request.resource.data.revisado == request.time;
      allow delete: if esAdmin();
    }
    // Lista de pedidos esperando sello: solo primer nombre + inicial, app y número de orden (sin el código de la tarjeta).
    // Se crea junto con el reclamo y se borra cuando la dueña lo aprueba o lo rechaza.
    match /demo_matcha_pendientes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nombre','app','orden','creado'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
        && request.resource.data.creado == request.time
        && existsAfter(/databases/$(database)/documents/demo_matcha_reclamos/$(id))
        && getAfter(/databases/$(database)/documents/demo_matcha_reclamos/$(id)).data.estado == 'pendiente';
      allow delete: if esAdmin()
        || (exists(/databases/$(database)/documents/demo_matcha_reclamos/$(id))
          && getAfter(/databases/$(database)/documents/demo_matcha_reclamos/$(id)).data.estado != 'pendiente');
    }
    match /prueba_matcha_pendientes/{id} {
      allow read, delete: if true;
      allow create, update: if id.size() <= 40 && request.resource.data.keys().hasOnly(['nombre','app','orden','creado'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40;
    }
    match /prueba_matcha_reclamos/{id} {
      allow read, delete: if true;
      allow create, update: if id.size() <= 40
        && request.resource.data.keys().hasOnly(['t','nombre','app','orden','estado','creado','sellos','revisado'])
        && request.resource.data.estado in ['pendiente', 'aprobado', 'rechazado'];
    }

    // Promociones de Koktela: todos las ven; en la versión real solo la dueña (con su acceso seguro) las publica.
    match /demo_koktela_promos/{id} {
      allow read: if true;
      allow create, update: if esAdmin() && promoOk(request.resource.data);
      allow delete: if esAdmin();
    }
    match /prueba_koktela_promos/{id} {
      allow read, delete: if true;
      allow create, update: if promoOk(request.resource.data);
    }
    // Promociones de Matcha Mía: todos las ven; en la versión real solo la dueña (con su acceso seguro) las publica.
    match /demo_matcha_promos/{id} {
      allow read: if true;
      allow create, update: if esAdmin() && promoOk(request.resource.data);
      allow delete: if esAdmin();
    }
    match /prueba_matcha_promos/{id} {
      allow read, delete: if true;
      allow create, update: if promoOk(request.resource.data);
    }

    match /{path=**} { allow read, write: if false; }
  }
}
